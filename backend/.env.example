# Obligatoria. En Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql+psycopg2://ski_app:ski_app@localhost:5432/ski_app

# development (default) | production. production apaga /docs, /redoc y
# /openapi.json y exige SITE_PASSWORD.
APP_ENV=development

# Contrasena compartida del sitio (HTTP Basic Auth). Vacia = sin auth (solo
# para desarrollo local). SITE_USER vacio acepta cualquier nombre de usuario.
SITE_PASSWORD=
SITE_USER=

# Raiz de los archivos subidos (videos/, season_reviews/, _incoming/).
# Relativa a backend/ o absoluta. En Railway: el punto de montaje del volumen.
MEDIA_ROOT=media
MAX_VIDEO_UPLOAD_MB=500

# Interprete con mediapipe/opencv. Por defecto, ai-analysis/.venv si existe.
# AI_ANALYSIS_PYTHON=
# AI_ANALYSIS_DIR=   (ruta absoluta; por defecto <repo>/ai-analysis)
MAX_CONCURRENT_ANALYSES=1

# Los usa el CMD del contenedor (uvicorn --host/--port); Railway inyecta PORT.
# HOST=0.0.0.0
# PORT=8000
